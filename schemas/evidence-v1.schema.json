{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Chassis portable run evidence v1",
  "type": "object",
  "required": ["schema_version", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agent-chassis.evidence/v1"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "provider_error_code": {"enum": ["invalid_request_error", "authentication_error", "permission_error", "rate_limit_error", "insufficient_quota", "model_not_found", "context_length_exceeded", "unsupported_parameter", "invalid_api_key", "overloaded_error", "api_error", "server_error", "not_found_error", "request_too_large"]},
    "http_error": {
      "type": "object", "required": ["status", "category"], "additionalProperties": false,
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 999},
        "category": {"enum": ["invalid_request", "authentication", "permission", "not_found", "request_timeout", "request_too_large", "rate_limit", "server_error", "http_error"]},
        "provider_code": {"$ref": "#/$defs/provider_error_code"}, "provider_type": {"$ref": "#/$defs/provider_error_code"},
        "request_id_sha256": {"$ref": "#/$defs/hash"},
        "retry_after_seconds": {"type": "integer", "minimum": 0, "maximum": 999999999}
      }
    },
    "positive": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object", "required": ["commit", "dirty"], "additionalProperties": false,
      "properties": {"commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "dirty": {"type": "boolean"}, "changes_id": {"$ref": "#/$defs/hash"}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_iterations", "max_parallel_tools", "max_batch_calls", "max_tool_calls"],
      "properties": {"max_iterations": {"$ref": "#/$defs/positive"}, "max_parallel_tools": {"$ref": "#/$defs/positive"},
        "max_batch_calls": {"$ref": "#/$defs/positive"}, "max_tool_calls": {"$ref": "#/$defs/positive"}}
    },
    "execution": {
      "type": "object", "required": ["runs", "batches", "parallel_observed"], "additionalProperties": false,
      "properties": {
        "parallel_observed": {"type": "boolean"},
        "runs": {"type": "array", "items": {
          "type": "object", "required": ["execution_id", "key", "attempt", "limits", "parallel_safe_tools"], "additionalProperties": false,
          "properties": {"execution_id": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1},
            "attempt": {"$ref": "#/$defs/positive"}, "limits": {"$ref": "#/$defs/limits"},
            "parallel_safe_tools": {"$ref": "#/$defs/strings"}}
        }},
        "batches": {"type": "array", "items": {
          "type": "object", "required": ["batch_id", "execution_id", "call_ids", "requested", "started", "succeeded", "failed", "peak_in_flight"], "additionalProperties": false,
          "properties": {"batch_id": {"type": "string", "minLength": 1}, "execution_id": {"type": "string", "minLength": 1},
            "call_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "requested": {"$ref": "#/$defs/positive"}, "started": {"$ref": "#/$defs/count"},
            "succeeded": {"$ref": "#/$defs/count"}, "failed": {"$ref": "#/$defs/count"}, "peak_in_flight": {"$ref": "#/$defs/count"}}
        }}
      }
    },
    "check": {
      "type": "object", "required": ["name", "status", "attempt", "evidence_refs"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "not_run"]},
        "attempt": {"$ref": "#/$defs/positive"}, "evidence_refs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}}
    },
    "diagnostic": {
      "type": "object", "required": ["code"], "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "enum": ["PARALLEL_DISABLED", "TOOL_NOT_PARALLEL_SAFE", "UNKNOWN_TOOL", "DUPLICATE_CALL_ID", "INVALID_CALL_ID", "INVALID_TOOL_ARGUMENTS", "INVALID_BATCH", "BATCH_LIMIT_EXCEEDED", "TOOL_BUDGET_EXHAUSTED"]},
        "action_index": {"type": "integer", "minimum": 1}, "tool": {"type": "string"},
        "argument_path": {"type": "string"}, "constraint": {"type": "string"}
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "tokens": {"type": ["integer", "null"], "minimum": 0},
    "strings": {"type": "array", "items": {"type": "string"}},
    "verdict": {
      "type": "object", "required": ["done", "reason", "evidence"], "additionalProperties": false,
      "properties": {"done": {"type": "boolean"}, "reason": {"type": "string"}, "evidence": {"type": "object"}}
    },
    "injection": {
      "type": "object", "required": ["point", "provider", "label", "content_hash", "version", "chars"], "additionalProperties": false,
      "properties": {
        "point": {"type": "string"}, "provider": {"type": "string"}, "label": {"type": "string"},
        "content_hash": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
        "version": {"type": "string"}, "chars": {"$ref": "#/$defs/count"}
      }
    },
    "receipt": {
      "type": "object", "required": ["consumer", "points", "included", "omitted", "chars", "at_ms"], "additionalProperties": false,
      "properties": {
        "consumer": {"type": "string", "minLength": 1}, "points": {"$ref": "#/$defs/strings"},
        "included": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "omitted": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
        "chars": {"$ref": "#/$defs/count"}, "at_ms": {"$ref": "#/$defs/count"}
      }
    },
    "model_call": {
      "type": "object", "required": ["adapter", "model", "mode", "ok", "elapsed_ms", "input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "adapter": {"type": "string"}, "model": {"type": "string"}, "resolved_model": {"type": "string"},
        "mode": {"enum": ["live", "test-transport"]}, "ok": {"type": "boolean"},
        "elapsed_ms": {"$ref": "#/$defs/count"}, "request_id": {"type": "string"}, "error_type": {"type": "string"},
        "diagnostic": {"$ref": "#/$defs/diagnostic"},
        "http_error": {"$ref": "#/$defs/http_error"},
        "input_tokens": {"$ref": "#/$defs/tokens"}, "output_tokens": {"$ref": "#/$defs/tokens"}
      }
    },
    "run": {
      "type": "object",
      "required": ["schema_version", "content_id", "run_id", "task_key", "task_kind", "input_id", "code_ref", "assembly_id", "mode", "outcome", "verdict", "error", "cleanup", "steps", "elapsed_ms", "iterations", "stop_reason", "injections", "context_receipts", "tool_calls", "model_calls", "usage"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "agent-chassis.run/v1"}, "content_id": {"$ref": "#/$defs/hash"},
        "run_id": {"type": "string", "minLength": 1}, "task_key": {"type": "string"}, "task_kind": {"type": "string"},
        "input_id": {"$ref": "#/$defs/hash"}, "code_ref": {"type": "string"},
        "assembly_id": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}, "mode": {"type": "string"},
        "outcome": {"enum": ["succeeded", "failed", "skipped"]},
        "verdict": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/verdict"}]}, "error": {"type": "string"},
        "cleanup": {
          "type": "object", "required": ["actions", "policy_error"], "additionalProperties": false,
          "properties": {"actions": {"$ref": "#/$defs/strings"}, "policy_error": {"type": "string"}}
        },
        "steps": {"$ref": "#/$defs/strings"}, "elapsed_ms": {"$ref": "#/$defs/count"}, "iterations": {"$ref": "#/$defs/count"},
        "stop_reason": {"type": "string"}, "injections": {"type": "array", "items": {"$ref": "#/$defs/injection"}},
        "context_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}},
        "tool_calls": {
          "type": "array", "items": {
            "type": "object", "required": ["name", "ok", "elapsed_ms"], "additionalProperties": false,
            "properties": {"name": {"type": "string"}, "ok": {"type": "boolean"}, "elapsed_ms": {"$ref": "#/$defs/count"},
              "call_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}},
            "dependentRequired": {"call_id": ["batch_id"], "batch_id": ["call_id"]}
          }
        },
        "model_calls": {"type": "array", "items": {"$ref": "#/$defs/model_call"}},
        "source": {"$ref": "#/$defs/source"}, "attempt": {"$ref": "#/$defs/positive"},
        "execution": {"$ref": "#/$defs/execution"}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "usage": {
          "type": "object", "required": ["complete", "input_tokens", "output_tokens"], "additionalProperties": false,
          "properties": {"complete": {"type": "boolean"}, "input_tokens": {"$ref": "#/$defs/tokens"}, "output_tokens": {"$ref": "#/$defs/tokens"}}
        }
      }
    }
  }
}
